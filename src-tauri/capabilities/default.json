{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "opener:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "osascript",
          "cmd": "osascript",
          "args": true
        }
      ]
    },
    "fs:allow-stat",
    "fs:allow-remove",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        },
        {
          "path": "$HOME/Wallflow/*"
        },
        {
          "path": "$HOME/Wallflow/Wallpapers/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        },
        {
          "path": "$HOME/Wallflow/*"
        },
        {
          "path": "$HOME/Wallflow/Wallpapers/*"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-write-file",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/Wallflow/**"
        }
      ]
    },
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://wallhaven.cc/api/*"
        },
        {
          "url": "https://w.wallhaven.cc/*"
        },
        {
          "url": "https://th.wallhaven.cc/*"
        },
        {
          "url": "https://api.artic.edu/*"
        },
        {
          "url": "https://www.artic.edu/iiif/*"
        },
        {
          "url": "https://images-api.nasa.gov/*"
        },
        {
          "url": "https://images-assets.nasa.gov/*"
        }
      ]
    },
    "store:default",
    "dialog:default"
  ]
}